<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>1401</AssemblyName>
    <RootNamespace>A1401</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.9.0</Version>
    <Company>NullMoth Systems</Company>
    <Authors>NullMoth Systems</Authors>
    <Copyright>© 2026 NullMoth Systems</Copyright>
    <Product>1401</Product>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=C:\NullMoth\1401</PathMap>
    <Deterministic>true</Deterministic>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="moth-mark.jpg" LogicalName="moth-mark.jpg" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>
