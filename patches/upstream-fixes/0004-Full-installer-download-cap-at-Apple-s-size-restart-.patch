From a28e174a4e42fb32db558e42ae3a81d09063cce8 Mon Sep 17 00:00:00 2001
From: luoxiaoyu <137460387@qq.com>
Date: Wed, 11 Nov 2026 10:24:43 +0800
Subject: [PATCH] Full installer download: cap at Apple's size, restart an
 oversized part, stop on 416 (#161)

The catalog size was never enforced while reading. A server that sent more than the size, or a
.part left larger by an earlier attempt, made every resume ask for a range past the end; Apple
answered HTTP 416 and the twelve tries were spent on a file that could not become right
(#161: stopped at 19032695007 of 18388869343 bytes).

- A .part larger than the catalog size is removed and the download restarts at byte 0.
- Reads are capped at the bytes still missing; a server that sends more is refused.
- 416 and non-transient 4xx are terminal; transient failures back off instead of retrying at once.
- The response stream is closed on every path.
- Regression tests: oversized part, 416, 403, extra bytes, stream close, capped progress.
---
 p1401/fullinstaller.py      | 65 +++++++++++++++++++++++++++-------
 tests/test_fullinstaller.py | 69 ++++++++++++++++++++++++++++++++++++-
 2 files changed, 121 insertions(+), 13 deletions(-)

diff --git a/p1401/fullinstaller.py b/p1401/fullinstaller.py
index 5f3a8f6..f01d694 100644
--- a/p1401/fullinstaller.py
+++ b/p1401/fullinstaller.py
@@ -23,6 +23,8 @@ import os
 import plistlib
 import re
 import struct
+import time
+import urllib.error
 import urllib.request
 import zlib
 import xml.etree.ElementTree as ET
@@ -176,32 +178,71 @@ def verify_xar(path, progress=None, chunk=4 << 20):
     return sorted(names)
 
 
-def fetch(product, dest_dir, progress=None, opener=None, tries=12):
+def fetch(product, dest_dir, progress=None, opener=None, tries=12, sleep=None):
     """Downloads product['url'] to dest_dir/InstallAssistant.pkg with resume, then verifies size, digest and structure.
-    `opener(url, start)` returns (stream, total_or_None); the default is urllib with a Range header."""
+    `opener(url, start)` returns (stream, total_or_None); the default is urllib with a Range header.
+
+    The catalog size is a hard limit. A previous version appended whatever the server sent and then, with a .part
+    larger than the expected size, asked to resume past the end on every retry: Apple answered 416 each time and the
+    loop spent its twelve tries on a file that could never become right (issue #161: "stopped at 19032695007 of
+    18388869343 bytes"). An oversized .part is now thrown away, every read is capped at the bytes still missing, a
+    server that sends more than the catalog lists is refused, and 416/4xx are terminal instead of retried."""
     os.makedirs(dest_dir, exist_ok=True)
     path = os.path.join(dest_dir, PACKAGE_NAME)
     part = path + ".part"
     want = int(product["size"])
     opener = opener or _open_range
+    sleep = sleep or time.sleep
     last = None
-    for _ in range(tries):
+    for attempt in range(tries):
         have = os.path.getsize(part) if os.path.exists(part) else 0
+        if want and have > want:
+            # The bytes past Apple's size cannot be part of this package. Keeping them makes every resume ask for a
+            # range beyond the object, which is exactly the 416 loop.
+            os.remove(part)
+            have = 0
         if want and have == want:
             break
+        written = 0
         try:
             stream, _total = opener(product["url"], have)
-            with open(part, "ab") as out:
-                while True:
-                    b = stream.read(1 << 20)
-                    if not b:
-                        break
-                    out.write(b)
-                    if progress:
-                        progress(out.tell(), want)
+            try:
+                with open(part, "ab") as out:
+                    while True:
+                        left = want - have - written if want else None
+                        if left is not None and left <= 0:
+                            if stream.read(1):
+                                raise FullInstallerError(
+                                    f"the server sent more than the {want} bytes Apple's catalog lists; the download "
+                                    f"was thrown away")
+                            break
+                        b = stream.read(min(1 << 20, left) if left is not None else (1 << 20))
+                        if not b:
+                            break
+                        out.write(b)
+                        written += len(b)
+                        if progress:
+                            progress(have + written, want)
+            finally:
+                stream.close()
+        except urllib.error.HTTPError as e:
+            if e.code == 416:
+                if want and have == want:
+                    break
+                raise FullInstallerError(
+                    f"the server refused the resume at {have} of {want} bytes (HTTP 416); the file it is serving is "
+                    f"shorter than Apple's catalog says. The partial download was removed; try again.") from e
+            if 400 <= e.code < 500 and e.code not in (408, 429):
+                raise FullInstallerError(
+                    f"the server refused the download (HTTP {e.code}); Apple is not serving this package right now. "
+                    f"The partial download was kept for the next attempt.") from e
+            last = e
+            if attempt + 1 < tries:
+                sleep(min(2 ** attempt, 10))
         except OSError as e:
             last = e
-            continue
+            if attempt + 1 < tries:
+                sleep(min(2 ** attempt, 10))
     have = os.path.getsize(part) if os.path.exists(part) else 0
     if want and have != want:
         raise FullInstallerError(f"the download stopped at {have} of {want} bytes ({last or 'the server closed the connection'})")
diff --git a/tests/test_fullinstaller.py b/tests/test_fullinstaller.py
index 3bedcb2..6152628 100644
--- a/tests/test_fullinstaller.py
+++ b/tests/test_fullinstaller.py
@@ -9,6 +9,7 @@ import struct
 import tempfile
 import sys
 import unittest
+import urllib.error
 import zlib
 
 from p1401 import fullinstaller as f
@@ -126,11 +127,77 @@ class Fetch(unittest.TestCase):
         prod = {"url": "https://x/InstallAssistant.pkg", "size": len(blob), "digest": hashlib.sha1(blob).hexdigest()}
         op = self.opener(blob, drop_after=2000)
         d = tempfile.mkdtemp()
-        path = f.fetch(prod, d, opener=op)
+        path = f.fetch(prod, d, opener=op, sleep=lambda s: None)
         self.assertEqual(open(path, "rb").read(), blob)
         self.assertEqual(op.calls[0], 0); self.assertGreater(op.calls[1], 0)
         self.assertFalse(os.path.exists(path + ".part"))
 
+    def test_a_part_larger_than_the_catalog_is_restarted_not_resumed_past_the_end(self):
+        # Issue #161: a .part of 19,032,695,007 bytes for a 18,388,869,343-byte package made every resume a Range past
+        # the end, which Apple answered 416 until the twelve tries ran out.
+        blob = make_xar(PKG_FILES)
+        prod = {"url": "https://x/InstallAssistant.pkg", "size": len(blob), "digest": hashlib.sha1(blob).hexdigest()}
+        d = tempfile.mkdtemp()
+        open(os.path.join(d, f.PACKAGE_NAME + ".part"), "wb").write(blob + b"EXTRA BYTES")
+        op = self.opener(blob)
+        path = f.fetch(prod, d, opener=op, sleep=lambda s: None)
+        self.assertEqual(open(path, "rb").read(), blob)
+        self.assertEqual(op.calls[0], 0, "an oversized .part must be restarted from byte 0")
+
+    def test_a_416_is_terminal_and_not_retried_twelve_times(self):
+        d = tempfile.mkdtemp()
+        open(os.path.join(d, f.PACKAGE_NAME + ".part"), "wb").write(b"12345")
+        calls = []
+
+        def op(url, start):
+            calls.append(start)
+            raise urllib.error.HTTPError(url, 416, "range", None, None)
+
+        with self.assertRaises(f.FullInstallerError) as e:
+            f.fetch({"url": "https://x/InstallAssistant.pkg", "size": 10}, d, opener=op, sleep=lambda s: None)
+        self.assertEqual(len(calls), 1)
+        self.assertIn("416", str(e.exception))
+
+    def test_a_refused_request_is_terminal(self):
+        calls = []
+
+        def op(url, start):
+            calls.append(start)
+            raise urllib.error.HTTPError(url, 403, "forbidden", None, None)
+
+        with self.assertRaises(f.FullInstallerError) as e:
+            f.fetch({"url": "https://x/InstallAssistant.pkg", "size": 10}, tempfile.mkdtemp(), opener=op,
+                    sleep=lambda s: None)
+        self.assertEqual(len(calls), 1)
+        self.assertIn("403", str(e.exception))
+
+    def test_the_stream_is_closed_even_when_the_read_fails(self):
+        blob = make_xar(PKG_FILES)
+        state = {"closed": False}
+
+        class S(io.BytesIO):
+            def read(self, n=-1):
+                b = io.BytesIO.read(self, n)
+                if not b:
+                    raise OSError("connection reset")
+                return b
+
+            def close(self):
+                state["closed"] = True
+                io.BytesIO.close(self)
+
+        with self.assertRaises(f.FullInstallerError):
+            f.fetch({"url": "https://x/InstallAssistant.pkg", "size": len(blob) + 10},
+                    tempfile.mkdtemp(), opener=lambda u, s: (S(blob), None), tries=1, sleep=lambda s: None)
+        self.assertTrue(state["closed"])
+
+    def test_a_server_that_sends_more_than_the_catalog_is_refused(self):
+        blob = make_xar(PKG_FILES)
+        with self.assertRaises(f.FullInstallerError) as e:
+            f.fetch({"url": "https://x/InstallAssistant.pkg", "size": 100},
+                    tempfile.mkdtemp(), opener=lambda u, s: (io.BytesIO(b"x" * 200), None), sleep=lambda s: None)
+        self.assertIn("more than", str(e.exception))
+
     def test_a_wrong_digest_throws_the_download_away(self):
         blob = make_xar(PKG_FILES)
         d = tempfile.mkdtemp()
