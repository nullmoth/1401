  "policy_changes": [
    {
      "rule": "tahoe-intel-bt",
      "before": "",
      "after": "-ibtcompatbeta",
      "why": "Dortania Tahoe page: Intel Bluetooth on macOS 26 needs -ibtcompatbeta"
    },
    {
      "rule": "tahoe-sbvmm",
      "before": "",
      "after": "revpatch=sbvmm",
      "why": "Tahoe's secure-boot model-version check stops an unsupported Mac model at boot and during an update"
    },
    {
      "rule": "hybrid-intel-devmmio",
      "before": "DevirtualiseMmio=True",
      "after": "DevirtualiseMmio=False",
      "why": "hybrid-core Intel laptops fault in boot.efi (EXITBS:START, type 14) with firmware MMIO devirtualised"
    },
    {
      "rule": "hybrid-intel-bios",
      "before": "",
      "after": "If this PC stops at EXITBS:START before macOS starts, turn off Hyper-Threading (or the E-cores) in the BIOS. This build re-maps the cores in software (CpuTopologyRebuild) for firmware that hides the switch, but the BIOS setting is the surest fix when it is there.",
      "why": "hybrid-core Intel stops at the kernel hand-off (EXITBS:START)"
    },
    {
      "rule": "keep-boot-args",
      "before": "Delete boot-args",
      "after": "keep existing boot-args",
      "why": "never overwrite an installed system's boot flags"
    },
    {
      "rule": "boot-logs-on-stick",
      "before": "Target 3, AppleDebug False, ApplePanic False",
      "after": "Target 67, AppleDebug, ApplePanic",
      "why": "boot and panic logs are written to the stick, so a failed start can be reported from Windows"
    },
    {
      "rule": "show-installer-entry",
      "before": "HideAuxiliary=True",
      "after": "HideAuxiliary=False",
      "why": "the macOS installer on the stick is a recovery entry; it was hidden in the boot picker"
    },
    {
      "rule": "expose-boot-path",
      "before": "6",
      "after": "7",
      "why": "lets the Mac app confirm which partition OpenCore started from"
    },
    {
      "rule": "relocation-block",
      "before": "AllowRelocationBlock=False",
      "after": "AllowRelocationBlock=True",
      "why": "boot.efi stops (STOP 0x16) when low memory has no room for the kernel; the block is used only then"
    },
    {
      "rule": "sip-minimal",
      "before": "030a0000",
      "after": "03000000",
      "why": "VoodooHDA on Tahoe loads from /Library/Extensions (Dortania: csr 03000000)"
    },
    {
      "rule": "machine-recipe",
      "before": "CPUID leaf 1 logical processors per package unchanged",
      "after": "128",
      "why": "The i7-1360P is the same 4 performance + 8 efficiency core part as the XPS 13 Plus 9320 recipe: with ProvideCurrentCpuInfo on, the CPUID leaf 1 logical-processor field must agree with the kernel's per-package count or cpu_thread_alloc divides by zero right after EXITBS. The value is applied because the same CPU and the same hybrid topology are present; it is unverified on this board and must be confirmed by a real boot before the row becomes works. If the board freezes after EXITBS with E-cores enabled, this is the first setting to review."
    },
    {
      "rule": "acpi-extra-processors",
      "before": "64 processor devices, 16 enabled in the MADT",
      "after": "48 device(s) hidden",
      "why": "macOS waits for processors that never start and panics in the scheduler"
    }
  ],
